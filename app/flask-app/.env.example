# Flask Backend Environment Variables
# Copy this file to .env and update with your actual values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# CORS Configuration
# For development: * (all origins)
# For production: https://your-frontend-domain.com
CORS_ORIGINS=*

# Model Configuration
MODEL_PATH=./models/best_100l.pt
MODEL_DEVICE=auto  # auto, cpu, or cuda
IMAGE_SIZE=800
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.6

# Cache Configuration
ENABLE_CACHE=True
CACHE_SIZE=50
MAX_IMAGE_SIZE_PX=1920

# Security
# Set to True in production to require authentication
REQUIRE_AUTH=False
# JWT secret for token generation (change in production)
JWT_SECRET=your-jwt-secret-change-this

# Optional: Database (for future use)
# DATABASE_URL=postgresql://user:pass@localhost/dbname

# Optional: Redis (for advanced caching)
# REDIS_URL=redis://localhost:6379/0

# Optional: File Storage (for production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Rate Limiting (requests per minute per IP)
RATE_LIMIT=30
